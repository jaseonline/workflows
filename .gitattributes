# Normalise to LF in the repo; hooks and CI scripts break on CRLF
* text=auto eol=lf

# Windows scripts keep CRLF
*.ps1 text eol=crlf
*.psm1 text eol=crlf
*.psd1 text eol=crlf
*.cmd text eol=crlf
*.bat text eol=crlf

# Binary
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.webp binary
*.pdf binary
*.zip binary
*.gz binary
*.mcpb binary
*.vsix binary
